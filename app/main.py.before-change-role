            if username is None:
                self.send_response(302)
                self.send_header("Location", "/templates/login.html")
                self.end_headers()
                return

            connection = sqlite3.connect(DB)
            cursor = connection.cursor()
            cursor.execute(
                """
                SELECT full_name, account_number, balance, role
                FROM users
                WHERE username = ?
                """,
                (username,)
            )
            user = cursor.fetchone()
            connection.close()

            if user is None:
                self.send_response(302)
                self.send_header("Location", "/templates/login.html")
                self.end_headers()
                return

            full_name, account_number, balance, role = user
            transactions = get_transactions(username)

            if transactions:
                history_html = "<table border='1'>"
                history_html += (
                    "<tr>"
                    "<th>Type</th>"
                    "<th>Amount</th>"
                    "<th>Date</th>"
                    "</tr>"
                )
                for transaction_type, amount, created_at in transactions:
                    history_html += (
                        "<tr>"
                        f"<td>{transaction_type}</td>"
                        f"<td>ETB {amount:.2f}</td>"
                        f"<td>{created_at}</td>"
                        "</tr>"
                    )
                history_html += "</table>"
            else:
                history_html = "<p>No transactions yet.</p>"

            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()

            dashboard = f"""
            <html>
            <body>
                <h1>🏦 ShueBank</h1>
                <h2>Welcome, {full_name}!</h2>

                <p>Account Number:</p>
                <h3>{account_number}</h3>

                <p>Balance:</p>
                <h2>ETB {balance:.2f}</h2>

                <h3>Deposit Money</h3>
                <form method="POST" action="/deposit">
                    <input type="number" name="amount" placeholder="Enter amount" min="1" required>
                    <button type="submit">Deposit</button>
                </form>

                <h3>Withdraw Money</h3>
                <form method="POST" action="/withdraw">
                    <input type="number" name="amount" placeholder="Enter amount" min="1" required>
                    <button type="submit">Withdraw</button>
                </form>

                <h3>Send Money</h3>
                <form method="POST" action="/send">
                    <input type="text" name="receiver_account" placeholder="Receiver Account Number" required>
                    <input type="number" name="amount" placeholder="Enter amount" min="1" required>
                    <button type="submit">Send Money</button>
                </form>

                <h3>Transaction History</h3>
                {history_html}

                {("<p><a href='/admin'>Admin Dashboard</a></p>" if role == "admin" else "")}

                <br>
                <a href="/logout">Logout</a>
            </body>
            </html>
            """

            self.wfile.write(dashboard.encode("utf-8"))
            return

        if self.path == "/admin":
            username = get_session_username(self)
            if username is None:
                self.send_response(302)
                self.send_header("Location", "/templates/login.html")
                self.end_headers()
                return

            connection = sqlite3.connect(DB)
            cursor = connection.cursor()
            cursor.execute("SELECT full_name, role FROM users WHERE username = ?", (username,))
            admin = cursor.fetchone()

            if admin is None or admin[1] != "admin":
                connection.close()
                self.send_response(403)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                self.wfile.write(b"<h1>403 Forbidden</h1><p>Admin access required.</p><a href=\"/dashboard\">Back to Dashboard</a>")
                return

            cursor.execute("SELECT id, full_name, username, account_number, balance, role, status FROM users ORDER BY id")
            users = cursor.fetchall()

            cursor.execute("SELECT id, username, transaction_type, amount, created_at FROM transactions ORDER BY id DESC")
            transactions = cursor.fetchall()
            connection.close()

            rows = ""
            for user_id, full_name, user_username, account_number, balance, role, status in users:
                action = ""
                if user_username != username:
                    if status == "active":
                        action = f"<form method='POST' action='/admin/toggle-user' style='display:inline'><input type='hidden' name='username' value='{user_username}'><button type='submit'>Deactivate</button></form>"
                    else:
                        action = f"<form method='POST' action='/admin/toggle-user' style='display:inline'><input type='hidden' name='username' value='{user_username}'><button type='submit'>Activate</button></form>"
                rows += f"<tr><td>{user_id}</td><td>{full_name}</td><td>{user_username}</td><td>{account_number}</td><td>ETB {balance:.2f}</td><td>{role}</td><td>{status}</td><td>{action}</td></tr>"

            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()

            page = f"""
            <html>
            <body>
                <h1>🏦 ShueBank Admin Dashboard</h1>
                <h2>Welcome, {admin[0]}!</h2>
                <h3>All Users</h3>
                <table border='1'>
                    <tr><th>ID</th><th>Name</th><th>Username</th><th>Account</th><th>Balance</th><th>Role</th><th>Status</th><th>Action</th></tr>
                    {rows}
                </table>
                <h3>Transaction History</h3>
                <table border='1'>
                    <tr><th>ID</th><th>Username</th><th>Type</th><th>Amount</th><th>Date/Time</th></tr>
                    {''.join(f"<tr><td>{tx_id}</td><td>{tx_username}</td><td>{tx_type}</td><td>ETB {tx_amount:.2f}</td><td>{tx_time}</td></tr>" for tx_id, tx_username, tx_type, tx_amount, tx_time in transactions)}
                </table>
                <br>
                <a href="/dashboard">Back to Dashboard</a> |
                <a href="/logout">Logout</a>
            </body>
            </html>
            """

            self.wfile.write(page.encode("utf-8"))
            return

        if self.path == "/logout":
            delete_session(self)
            self.send_response(302)
            self.send_header("Set-Cookie", "session_token=; Max-Age=0; HttpOnly; SameSite=Lax")
            self.send_header("Location", "/templates/login.html")
            self.end_headers()
