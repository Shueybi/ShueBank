from http.server import HTTPServer, SimpleHTTPRequestHandler
from urllib.parse import parse_qs
import sqlite3
import os
import secrets
import hashlib
from app.security.passwords import hash_password as _pbkdf2_hash, verify_password


PORT = 8000

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
os.chdir(BASE_DIR)

DB = os.path.join(BASE_DIR, "..", "shuebank.db")
SESSIONS = {}


def hash_password(password):
    return _pbkdf2_hash(password)


def create_account(full_name, username, password):
    account_number = "1000" + str(secrets.randbelow(900000) + 100000)
    connection = sqlite3.connect(DB)
    cursor = connection.cursor()
    try:
        cursor.execute(
            """
            INSERT INTO users
            (full_name, username, password, account_number, balance)
            VALUES (?, ?, ?, ?, ?)
            """,
            (
                full_name,
                username,
                hash_password(password),
                account_number,
                0
            )
        )
        connection.commit()
        return account_number
    except sqlite3.IntegrityError:
        return None
    finally:
        connection.close()


def check_login(username, password):
    connection = sqlite3.connect(DB)
    cursor = connection.cursor()
    cursor.execute(
        """
        SELECT full_name, account_number, balance, password, status
        FROM users
        WHERE username = ?
        """,
        (username,)
    )
    row = cursor.fetchone()
    if row is None:
        connection.close()
        return None

    full_name, account_number, balance, stored_hash, status = row

    if status != "active":
        connection.close()
        return None

    ok, needs_rehash = verify_password(password, stored_hash)
    if not ok:
        connection.close()
        return None

    if needs_rehash:
        cursor.execute(
            "UPDATE users SET password = ? WHERE username = ?",
            (hash_password(password), username)
        )
        connection.commit()

    connection.close()
    return (full_name, account_number, balance)


def deposit_money(username, amount):
    connection = sqlite3.connect(DB)
    cursor = connection.cursor()
    cursor.execute(
        "SELECT balance FROM users WHERE username = ?",
        (username,)
    )
    result = cursor.fetchone()
    if result is None:
        connection.close()
        return None
    cursor.execute(
        "UPDATE users SET balance = balance + ? WHERE username = ?",
        (amount, username)
    )
    cursor.execute(
        """
        INSERT INTO transactions
        (username, transaction_type, amount)
        VALUES (?, ?, ?)
        """,
        (username, "Deposit", amount)
    )
    connection.commit()
    cursor.execute(
        "SELECT balance FROM users WHERE username = ?",
        (username,)
    )
    result = cursor.fetchone()
    connection.close()
    return result[0] if result else None


def withdraw_money(username, amount):
    connection = sqlite3.connect(DB)
    cursor = connection.cursor()
    cursor.execute(
        "SELECT balance FROM users WHERE username = ?",
        (username,)
    )
    result = cursor.fetchone()
    if result is None:
        connection.close()
        return None
    balance = result[0]
    if amount > balance:
        connection.close()
        return False
    new_balance = balance - amount
    cursor.execute(
        "UPDATE users SET balance = ? WHERE username = ?",
        (new_balance, username)
    )
    cursor.execute(
        """
        INSERT INTO transactions
        (username, transaction_type, amount)
        VALUES (?, ?, ?)
        """,
        (username, "Withdraw", amount)
    )
    connection.commit()
    connection.close()
    return new_balance


def send_money(sender_username, receiver_account, amount):
    connection = sqlite3.connect(DB)
    cursor = connection.cursor()
    cursor.execute(
        "SELECT balance FROM users WHERE username = ?",
        (sender_username,)
    )
    sender = cursor.fetchone()
    if sender is None:
        connection.close()
        return "sender_not_found"
    cursor.execute(
        "SELECT username FROM users WHERE account_number = ?",
        (receiver_account,)
    )
    receiver = cursor.fetchone()
    if receiver is None:
        connection.close()
        return "receiver_not_found"
    if amount <= 0:
        connection.close()
        return "invalid_amount"
    if amount > sender[0]:
        connection.close()
        return "insufficient_balance"
    receiver_username = receiver[0]
    if receiver_username == sender_username:
        connection.close()
        return "same_account"
    cursor.execute(
        "UPDATE users SET balance = balance - ? WHERE username = ?",
        (amount, sender_username)
    )
    cursor.execute(
        "UPDATE users SET balance = balance + ? WHERE username = ?",
        (amount, receiver_username)
    )
    cursor.execute(
        """
        INSERT INTO transactions
        (username, transaction_type, amount)
        VALUES (?, ?, ?)
        """,
        (sender_username, "Send", amount)
    )
    cursor.execute(
        """
        INSERT INTO transactions
        (username, transaction_type, amount)
        VALUES (?, ?, ?)
        """,
        (receiver_username, "Receive", amount)
    )
    connection.commit()
    cursor.execute(
        "SELECT balance FROM users WHERE username = ?",
        (sender_username,)
    )
    new_balance = cursor.fetchone()[0]
    connection.close()
    return new_balance


def get_transactions(username):
    connection = sqlite3.connect(DB)
    cursor = connection.cursor()
    cursor.execute(
        """
        SELECT transaction_type, amount, created_at
        FROM transactions
        WHERE username = ?
        ORDER BY id DESC
        """,
        (username,)
    )
    transactions = cursor.fetchall()
    connection.close()
    return transactions


def get_session_username(handler):
    cookie = handler.headers.get("Cookie", "")
    for item in cookie.split(";"):
        item = item.strip()
        if item.startswith("session_token="):
            token = item.split("=", 1)[1]
            return SESSIONS.get(token)
    return None


def create_session(username):
    token = secrets.token_hex(32)
    SESSIONS[token] = username
    return token


def delete_session(handler):
    cookie = handler.headers.get("Cookie", "")
    for item in cookie.split(";"):
        item = item.strip()
        if item.startswith("session_token="):
            token = item.split("=", 1)[1]
            SESSIONS.pop(token, None)


class ShueBankHandler(SimpleHTTPRequestHandler):

    def do_GET(self):

        if self.path == "/dashboard":
