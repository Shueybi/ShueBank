    def do_POST(self):

        length = int(self.headers.get("Content-Length", 0))
        data = self.rfile.read(length).decode("utf-8")
        form = parse_qs(data)

        if self.path == "/admin/toggle-user":
            username = get_session_username(self)
            if username is None:
                self.send_response(302)
                self.send_header("Location", "/templates/login.html")
                self.end_headers()
                return

            connection = sqlite3.connect(DB)
            cursor = connection.cursor()
            cursor.execute("SELECT role FROM users WHERE username = ?", (username,))
            admin = cursor.fetchone()

            if admin is None or admin[0] != "admin":
                connection.close()
                self.send_response(403)
                self.end_headers()
                self.wfile.write(b"403 Forbidden")
                return

            target_username = form.get("username", [""])[0]
            cursor.execute("SELECT status FROM users WHERE username = ?", (target_username,))
            target = cursor.fetchone()

            if target is not None and target_username != username:
                new_status = "inactive" if target[0] == "active" else "active"
                cursor.execute("UPDATE users SET status = ? WHERE username = ?", (new_status, target_username))
                connection.commit()

            connection.close()

            self.send_response(302)
            self.send_header("Location", "/admin")
            self.end_headers()
            return

        if self.path == "/register":
            full_name = form.get("full_name", [""])[0]
            username = form.get("username", [""])[0]
            password = form.get("password", [""])[0]
            confirm_password = form.get("confirm_password", [""])[0]

            if password != confirm_password:
                self.send_error(400, "Passwords do not match.")
                return

            account_number = create_account(full_name, username, password)
            if account_number is None:
                self.send_error(400, "Username already exists.")
                return

            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()

            message = f"""
            <html>
            <body>
                <h1>🏦 ShueBank</h1>
                <h2>Account Created Successfully!</h2>
                <p>Welcome, {full_name}.</p>
                <p>Your account number is:</p>
                <h2>{account_number}</h2>
                <p>Initial balance: ETB 0.00</p>
                <a href="/templates/login.html">Go to Login</a>
            </body>
            </html>
            """
            self.wfile.write(message.encode("utf-8"))
            return

        if self.path == "/login":
            username = form.get("username", [""])[0]
            password = form.get("password", [""])[0]

            user = check_login(username, password)
            if user is None:
                self.send_response(401)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                self.wfile.write(
                    b"<h1>Login failed</h1>"
                    b"<p>Username or password is incorrect.</p>"
                    b'<a href="/templates/login.html">Try again</a>'
                )
                return

            token = create_session(username)
            self.send_response(302)
            self.send_header("Set-Cookie", f"session_token={token}; HttpOnly; SameSite=Lax")
            self.send_header("Location", "/dashboard")
            self.end_headers()
            return

        username = get_session_username(self)
        if username is None:
            self.send_response(401)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(
                b"<h1>Unauthorized</h1>"
                b"<p>Please login first.</p>"
                b'<a href="/templates/login.html">Login</a>'
            )
            return

        if self.path == "/deposit":
            try:
                amount = float(form.get("amount", [""])[0])
            except ValueError:
                self.send_error(400, "Invalid amount.")
                return
            if amount <= 0:
                self.send_error(400, "Amount must be greater than zero.")
                return

            new_balance = deposit_money(username, amount)
            if new_balance is None:
                self.send_error(404, "User not found.")
                return

            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()

            message = f"""
            <html>
            <body>
                <h1>🏦 ShueBank</h1>
                <h2>Deposit Successful!</h2>
                <p>You deposited: ETB {amount:.2f}</p>
                <h2>New Balance: ETB {new_balance:.2f}</h2>
                <a href="/dashboard">Back to Dashboard</a>
            </body>
            </html>
            """
            self.wfile.write(message.encode("utf-8"))
            return

        if self.path == "/withdraw":
            try:
                amount = float(form.get("amount", [""])[0])
            except ValueError:
                self.send_error(400, "Invalid amount.")
                return
            if amount <= 0:
                self.send_error(400, "Amount must be greater than zero.")
                return

            new_balance = withdraw_money(username, amount)
            if new_balance is None:
                self.send_error(404, "User not found.")
                return
            if new_balance is False:
                self.send_error(400, "Insufficient balance.")
                return

            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()

            message = f"""
            <html>
            <body>
                <h1>🏦 ShueBank</h1>
                <h2>Withdraw Successful!</h2>
                <p>You withdrew: ETB {amount:.2f}</p>
                <h2>New Balance: ETB {new_balance:.2f}</h2>
                <a href="/dashboard">Back to Dashboard</a>
            </body>
            </html>
            """
            self.wfile.write(message.encode("utf-8"))
            return

        if self.path == "/send":
            receiver_account = form.get("receiver_account", [""])[0]
            try:
                amount = float(form.get("amount", [""])[0])
            except ValueError:
                self.send_error(400, "Invalid amount.")
                return
            if amount <= 0:
                self.send_error(400, "Amount must be greater than zero.")
                return

            result = send_money(username, receiver_account, amount)

            if result == "sender_not_found":
                self.send_error(404, "Sender account not found.")
                return
            if result == "receiver_not_found":
                self.send_error(404, "Receiver account not found.")
                return
            if result == "same_account":
                self.send_error(400, "You cannot send money to yourself.")
                return
            if result == "insufficient_balance":
                self.send_error(400, "Insufficient balance.")
                return
            if result == "invalid_amount":
                self.send_error(400, "Invalid amount.")
                return

            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()

            message = f"""
            <html>
            <body>
                <h1>🏦 ShueBank</h1>
                <h2>Money Sent Successfully!</h2>
                <p>You sent: ETB {amount:.2f}</p>
                <p>Receiver Account: {receiver_account}</p>
                <h2>New Balance: ETB {result:.2f}</h2>
                <a href="/dashboard">Back to Dashboard</a>
            </body>
            </html>
            """
            self.wfile.write(message.encode("utf-8"))
            return

        self.send_error(404)


server = HTTPServer(("0.0.0.0", PORT), ShueBankHandler)

print(f"ShueBank server running on port {PORT}")
print("Open: http://127.0.0.1:8000/templates/login.html")

server.serve_forever()
